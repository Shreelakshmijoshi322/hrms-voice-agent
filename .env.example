# Required for both the Next.js token endpoint and the Python agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Optional LiveKit Inference overrides.
VOICE_AGENT_NAME=hr-assistant
VOICE_STT_MODEL=deepgram/nova-3:en
VOICE_LLM_MODEL=google/gemma-4-31b-it
VOICE_TTS_MODEL=inworld/inworld-tts-2:Ashley

# Optional local mutable demo state.
HRMS_DEMO_DB=agent/data/hrms-demo.sqlite
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
