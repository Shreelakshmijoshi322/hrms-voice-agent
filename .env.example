# Required for both the Next.js token endpoint and the Python agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Optional LiveKit Inference overrides.
VOICE_AGENT_NAME=hr-assistant
VOICE_WORKER_PORT=8091
VOICE_STT_MODEL=deepgram/nova-3:multi
VOICE_LLM_MODEL=google/gemma-4-31b-it
VOICE_TTS_MODEL=inworld/inworld-tts-2:Ashley

# Direct Deepgram STT/TTS (LiveKit remains the room/audio transport).
# Add the key to your ignored .env.local to enable these providers.
# DEEPGRAM_API_KEY=your-deepgram-key
VOICE_DIRECT_DEEPGRAM=true
DEEPGRAM_STT_MODEL=nova-3
# Use `multi` for English plus multilingual Nova-3 support, or `kn` for a
# Kannada-only worker.
DEEPGRAM_STT_LANGUAGE=multi
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Recommended bilingual Kannada/English provider. Requires SARVAM_API_KEY.
VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Kannada-capable Google Cloud TTS. Set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account JSON file before using VOICE_TTS_PROVIDER=google.
VOICE_TTS_PROVIDER=google
GOOGLE_TTS_LANGUAGE=kn-IN
GOOGLE_TTS_VOICE=kn-IN-Standard-A
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/google-service-account.json

# Meta WhatsApp Cloud API. Keep these server-side only.
WHATSAPP_MOCK_MODE=true
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
# The internal service that will run Sarvam STT -> HRMS agent -> Sarvam TTS.
# Keep this empty until that service is deployed; live audio processing will
# fail closed rather than sending a fabricated HR answer.
WHATSAPP_AUDIO_PROCESSOR_URL=
WHATSAPP_HRMS_AGENT_URL=http://127.0.0.1:8092/answer
WHATSAPP_AGENT_PORT=8092
WHATSAPP_INTERNAL_SECRET=replace-with-a-long-random-internal-secret
# JSON map of normalized WhatsApp sender number to an existing HRMS session.
# Never commit this value; it contains authenticated session cookies.
WHATSAPP_EMPLOYEE_SESSIONS_JSON={}
SARVAM_STT_MODEL=saaras:v4

# Optional local mutable demo state.
HRMS_DEMO_DB=agent/data/hrms-demo.sqlite
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# HRMS integration (the browser keeps the HttpOnly HRMS session cookie).
HRMS_CORE_URL=http://localhost:8081
# Internal server-to-server secret used by the mobile one-time sign-in handoff.
# Set the same value in HRMS Core as HRMS_MOBILE_HANDOFF_SECRET.
HRMS_MOBILE_HANDOFF_SECRET=replace-with-a-long-random-internal-secret
HRMS_AI_WS_URL=ws://localhost:8083/api/v1/chat/widget
CORE_SESSION_TOKEN_URL=http://localhost:8081/internal/ai/session-token
CORE_SESSION_TOKEN_SECRET=hrms-e2e-ai-session-secret-change-before-production
