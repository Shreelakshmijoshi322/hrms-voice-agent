{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-3001/types/**/*.ts",
    ".next-3001/dev/types/**/*.ts",
    ".next-whatsapp/types/**/*.ts",
    ".next-whatsapp/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "agentlabs-auth",
    "agentlabs-auth-doc",
    "agentlabs-auth-ui",
    "agentlabs-go-common",
    "agentlabs-hrms-ai",
    "agentlabs-hrms-core",
    "agentlabs-hrms-docs",
    "agentlabs-hrms-e2e",
    "agentlabs-hrms-ui"
    ,"mobile"
  ]
}
